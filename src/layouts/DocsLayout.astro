---
/**
 * Docs page shell on top of BaseLayout: sticky contents sidebar (a <details> sheet on narrow
 * screens), the article, an "On this page" rail from 1200 px, and a foot with the last-updated
 * date, an "Edit on GitHub" link and previous/next pages. Copy comes from content/pages/docs.ts.
 */
import BaseLayout from "~/layouts/BaseLayout.astro";
import DocsNav from "~/components/docs/DocsNav.astro";
import type { DocsNavGroup, DocsPagerLink } from "~/components/docs/docs-types";
import DocsSearch from "~/components/docs/DocsSearch.astro";
import DocsToc from "~/components/docs/DocsToc.astro";
import DocsPager from "~/components/docs/DocsPager.astro";
import Icon from "~/components/ui/Icon.astro";
import PageActions from "~/components/layout/PageActions.astro";
import { formatDate, localePath, pick, type Locale } from "~/i18n/config";
import { DOCS_UI } from "~/content/pages/docs";

interface Props {
  locale: Locale;
  title: string;
  description: string;
  /** Unprefixed path, e.g. /docs/get-started/quickstart */
  path: string;
  section: string;
  groups: DocsNavGroup[];
  headings: { depth: number; slug: string; text: string }[];
  updated: Date;
  editUrl: string;
  prev?: DocsPagerLink;
  next?: DocsPagerLink;
  jsonLd?: Record<string, unknown>[];
}
const { locale, title, description, path, section, groups, headings, updated, editUrl, prev, next, jsonLd = [] } = Astro.props;
const ui = pick(DOCS_UI, locale);
const searchIndex = localePath(locale, "/docs/search-index.json");
const searchLabels = { ...ui.search };
---

<BaseLayout
  pageActions={false}
  title={title}
  description={description}
  locale={locale}
  path={path}
  type="article"
  modified={updated.toISOString()}
  breadcrumbs={[{ name: ui.meta.crumb, path: "/docs" }, { name: title, path }]}
  jsonLd={jsonLd}
>
  <div class="container docs">
    <div class="docs__side">
      <div class="docs__side-inner">
        <DocsSearch id="docs-side-search" index={searchIndex} labels={searchLabels} />
        <DocsNav groups={groups} label={ui.nav.label} />
      </div>
    </div>

    <div class="docs__main">
      <div class="docs__mobile">
        <DocsSearch id="docs-mobile-search" index={searchIndex} labels={searchLabels} />
        <details class="docs__sheet">
          <summary class="docs__sheet-summary">
            <Icon name="list" />
            <span class="docs__sheet-label">{ui.nav.menu}</span>
            <span class="docs__sheet-where">{section}</span>
            <Icon name="chevron-down" class="docs__sheet-chev" />
          </summary>
          <div class="docs__sheet-body"><DocsNav groups={groups} label={ui.nav.menu} /></div>
        </details>
      </div>

      <article class="doc" data-md-root>
        <header class="doc__head">
          <div class="doc__kicker">
            <p class="eyebrow">{section}</p>
            <PageActions locale={locale} path={path} title={title} />
          </div>
          <h1 class="doc__title">{title}</h1>
          <p class="lede doc__lede">{description}</p>
        </header>
        <slot />
        <footer class="doc__foot" data-md-skip>
          <div class="doc__meta">
            <span>{ui.nav.updated} <time datetime={updated.toISOString().slice(0, 10)}>{formatDate(updated, locale, { year: "numeric", month: "long", day: "numeric" })}</time></span>
            <a class="doc__edit" href={editUrl} rel="noopener"><Icon name="pen-line" size={16} />{ui.nav.edit}</a>
          </div>
          <DocsPager prev={prev} next={next} labels={{ previous: ui.nav.previous, next: ui.nav.next }} />
        </footer>
      </article>
    </div>

    <div class="docs__toc">
      <div class="docs__toc-inner"><DocsToc headings={headings} label={ui.nav.onThisPage} /></div>
    </div>
  </div>
</BaseLayout>

<style>
  .docs {
    --docs-top: calc(4.25rem + var(--space-5));
    display: grid; grid-template-columns: 15rem minmax(0, 1fr) 12.5rem; gap: clamp(2rem, 0.5rem + 2.5vw, 3.25rem);
    align-items: start; padding-block: var(--space-7) var(--space-9);
  }
  .docs__side-inner, .docs__toc-inner {
    position: sticky; inset-block-start: var(--docs-top); max-block-size: calc(100dvh - var(--docs-top) - var(--space-4));
    overflow-y: auto; overscroll-behavior: contain; scrollbar-width: thin;
  }
  .docs__side-inner { display: grid; gap: var(--space-5); align-content: start; padding: var(--space-1) var(--space-2) var(--space-6) var(--space-1); margin-inline-start: calc(var(--space-1) * -1); }
  .docs__toc-inner { padding-block-start: var(--space-2); }
  .docs__mobile { display: none; }

  .doc { min-inline-size: 0; }
  .doc__kicker { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--space-3); }
  .doc__head { display: grid; gap: var(--space-4); padding-block-end: var(--space-6); margin-block-end: var(--space-6); border-block-end: 1px solid var(--rule); }
  .doc__title { font-size: var(--step-4); line-height: 1.1; max-inline-size: 22ch; text-wrap: balance; }
  .doc__lede { max-inline-size: 46rem; font-size: var(--step-1); }
  .doc__foot { display: grid; gap: var(--space-6); margin-block-start: var(--space-9); padding-block-start: var(--space-5); border-block-start: 1px solid var(--rule); max-inline-size: 46rem; }
  .doc__meta { display: flex; flex-wrap: wrap; justify-content: space-between; gap: var(--space-3) var(--space-5); font-size: var(--step--1); color: var(--ink-3); }
  .doc__edit { display: inline-flex; align-items: center; gap: var(--space-2); min-block-size: 2.75rem; color: var(--accent-ink); font-weight: 500; text-decoration: none; }
  .doc__edit:hover { text-decoration: underline; }

  .docs__sheet { border: 1px solid var(--rule-strong); border-radius: var(--radius-3); background: var(--surface); box-shadow: var(--shadow-1); }
  .docs__sheet-summary {
    display: flex; align-items: center; gap: var(--space-2); min-block-size: 3rem; padding-inline: var(--space-4);
    list-style: none; cursor: pointer; font-size: var(--step--1); font-weight: 600;
  }
  .docs__sheet-summary::-webkit-details-marker { display: none; }
  .docs__sheet-where { overflow: hidden; white-space: nowrap; text-overflow: ellipsis; color: var(--ink-3); font-weight: 400; }
  .docs__sheet-where::before { content: "·"; margin-inline-end: var(--space-2); }
  .docs__sheet-summary :global(.docs__sheet-chev) { margin-inline-start: auto; flex: none; transition: rotate var(--dur-2) var(--ease-out); }
  .docs__sheet[open] .docs__sheet-summary :global(.docs__sheet-chev) { rotate: 180deg; }
  .docs__sheet-body { padding: var(--space-2) var(--space-3) var(--space-4); border-block-start: 1px solid var(--rule); }

  @media (max-width: 1199px) {
    .docs { grid-template-columns: 14.5rem minmax(0, 1fr); }
    .docs__toc { display: none; }
  }
  @media (max-width: 959px) {
    .docs { grid-template-columns: minmax(0, 1fr); padding-block-start: var(--space-5); }
    .docs__side { display: none; }
    .docs__mobile { display: grid; gap: var(--space-3); margin-block-end: var(--space-6); }
    .doc__title { font-size: var(--step-3); }
  }
</style>
