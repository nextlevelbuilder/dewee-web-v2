---
/** A pull quote in display italics with a red margin rule. Page-builder friendly. */
interface Props { text: string; cite?: string; role?: string }
const { text, cite, role } = Astro.props;
---
<figure class="pq" data-reveal>
  <blockquote><p>{text}</p></blockquote>
  {cite && <figcaption><b>{cite}</b>{role && <span>{role}</span>}</figcaption>}
</figure>
<style>
  .pq { max-inline-size: 48rem; margin-inline: auto; padding-inline-start: var(--space-6); border-inline-start: 3px solid var(--bronze); }
  .pq p { font-family: var(--font-display-stack); font-style: italic; font-size: var(--step-3); line-height: 1.25; color: var(--ink); text-wrap: balance; }
  .pq figcaption { display: flex; gap: var(--space-2); margin-block-start: var(--space-4); font-size: var(--step--1); color: var(--ink-3); }
  .pq b { color: var(--ink); }
</style>
