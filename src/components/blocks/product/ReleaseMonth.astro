---
/**
 * "New this month": a wall-calendar page on ô-ly paper with the release days circled in red pen,
 * next to one notebook entry per release. Circled days link to their entry. The calendar is a
 * real <table> (weekday headers, day cells) and stays sticky beside the entries on wide screens.
 * `month` is "YYYY-MM"; weeks start on Monday, as Vietnamese and ISO calendars do.
 */
import Icon from "~/components/ui/Icon.astro";

type Release = { version: string; iso: string; date: string; title: string; items: string[] };
interface Props {
  month: string;
  monthLabel: string;
  weekdays: string[];
  calendarLabel: string;
  releases: Release[];
  releasedOn: string;
  changelog?: { label: string; href: string };
  note?: string;
}
const { month, monthLabel, weekdays, calendarLabel, releases, releasedOn, changelog, note } = Astro.props;

const [year, mon] = month.split("-").map(Number);
const daysInMonth = new Date(Date.UTC(year, mon, 0)).getUTCDate();
const lead = (new Date(Date.UTC(year, mon - 1, 1)).getUTCDay() + 6) % 7; // Monday = 0
const cells: (number | null)[] = [...Array(lead).fill(null), ...Array.from({ length: daysInMonth }, (_, i) => i + 1)];
while (cells.length % 7) cells.push(null);
const weeks = Array.from({ length: cells.length / 7 }, (_, w) => cells.slice(w * 7, w * 7 + 7));

const anchor = (v: string) => `release-${v.replace(/\./g, "-")}`;
const short = (v: string) => `v${v.split(".").slice(0, 2).join(".")}`;
const byDay = new Map(
  releases.filter((r) => r.iso.startsWith(month)).map((r) => [Number(r.iso.slice(8, 10)), r] as const),
);
---

<div class="rm">
  <div class="rm__side">
    <div class="rm__sheet drum-texture" data-reveal>
      <span class="rm__rings" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
      <table class="rm__cal" aria-label={calendarLabel}>
        <caption class="rm__month">{monthLabel}</caption>
        <thead>
          <tr>{weekdays.map((d) => <th scope="col" abbr={d}>{d}</th>)}</tr>
        </thead>
        <tbody>
          {weeks.map((week) => (
            <tr>
              {week.map((day) => {
                if (!day) return <td class="rm__day rm__day--empty" />;
                const r = byDay.get(day);
                if (!r) return <td class="rm__day"><span class="rm__num">{day}</span></td>;
                return (
                  <td class="rm__day rm__day--release">
                    <a class="rm__hit" href={`#${anchor(r.version)}`} aria-label={`v${r.version}, ${r.date}`}>
                      <span class="rm__num">{day}</span>
                      <svg class="rm__circle" viewBox="0 0 44 36" preserveAspectRatio="none" aria-hidden="true">
                        <path pathLength="1" d="M9 21 C 5 9, 37 3, 40 16 S 16 35, 6 24 C 3 17, 11 8, 26 7" />
                      </svg>
                      <span class="rm__tag" aria-hidden="true">{short(r.version)}</span>
                    </a>
                  </td>
                );
              })}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    {note && <p class="note note--seal rm__note" aria-hidden="true">{note}</p>}
  </div>

  <div class="rm__list">
    <ol class="rm__entries" role="list" data-reveal-group>
      {releases.map((r) => (
        <li class="rm__entry" id={anchor(r.version)} data-reveal>
          <p class="rm__meta">
            <span class="chip chip--accent mono">v{r.version}</span>
            <span class="rm__date">{releasedOn} <time datetime={r.iso}>{r.date}</time></span>
          </p>
          <h3 class="rm__title">{r.title}</h3>
          <ul class="rm__items" role="list">
            {r.items.map((it) => (
              <li><Icon name="check" size={16} class="rm__tick" stroke={2.25} />{it}</li>
            ))}
          </ul>
        </li>
      ))}
    </ol>
    {changelog && (
      <a class="btn btn--ink rm__more" href={changelog.href}>{changelog.label}<Icon name="arrow-right" class="arrow" /></a>
    )}
  </div>
</div>

<style>
  .rm {
    display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(2rem, 1rem + 4vw, 5rem); align-items: start;
  }
  .rm__side { position: sticky; inset-block-start: 6rem; display: grid; gap: var(--space-4); }

  /* The calendar page: a spiral-bound sheet torn from a desk calendar */
  .rm__sheet {
    --cell: 9px;
    position: relative;
    padding: var(--space-7) clamp(1rem, 0.5rem + 1.5vw, 1.75rem) var(--space-5);
    background-color: var(--surface); border: 1px solid var(--rule); border-radius: var(--radius-3);
    box-shadow: var(--shadow-2); rotate: -1deg;
  }
  .rm__rings { position: absolute; inset-block-start: calc(var(--space-3) * -1); inset-inline: 18%; display: flex; justify-content: space-between; }
  .rm__rings i {
    inline-size: 10px; block-size: 26px; border-radius: var(--radius-round);
    border: 2px solid var(--rule-strong); background: var(--paper-2);
  }
  .rm__cal { inline-size: 100%; border-collapse: collapse; table-layout: fixed; text-align: center; }
  .rm__month {
    caption-side: top; text-align: start; padding-block-end: var(--space-4);
    font-family: var(--font-display-stack); font-size: var(--step-2); line-height: var(--leading-snug); color: var(--ink);
  }
  .rm__cal th {
    padding-block: var(--space-2); border-block-end: 1px solid var(--rule-strong);
    font-family: var(--font-mono-stack); font-size: var(--step--2); font-weight: 500; letter-spacing: 0.06em; text-transform: uppercase; color: var(--ink-3);
  }
  .rm__cal th:nth-child(7), .rm__day:nth-child(7) .rm__num { color: var(--seal); }
  .rm__day { block-size: clamp(2.9rem, 2.4rem + 1.6vw, 3.9rem); padding: 0; vertical-align: middle; border-block-end: 1px dashed var(--rule); }
  .rm__num { font-family: var(--font-display-stack); font-size: var(--step-0); color: var(--ink-2); font-variant-numeric: lining-nums tabular-nums; }
  .rm__day--release .rm__num { color: var(--ink); font-weight: 600; }
  .rm__hit {
    position: relative; display: grid; place-items: center; align-content: center; gap: 1px;
    inline-size: 100%; min-block-size: 2.9rem; padding-block: var(--space-1); border-radius: var(--radius-2);
    color: inherit; text-decoration: none;
  }
  .rm__hit:hover { background: var(--accent-soft); }
  .rm__circle {
    position: absolute; inset-block-start: 6%; inset-inline: 8%; inline-size: 84%; block-size: 62%;
    overflow: visible; pointer-events: none; color: var(--seal);
  }
  /* No non-scaling-stroke here: with it, Chrome measures the dash in screen space and a pathLength=1 dash stops short. */
  .rm__circle path { fill: none; stroke: currentColor; stroke-width: 1.9; stroke-linecap: round; stroke-dasharray: 1; stroke-dashoffset: 0; }
  .rm__tag { font-family: var(--font-mono-stack); font-size: 0.66rem; line-height: 1; color: var(--seal); letter-spacing: 0; }
  .rm__note { justify-self: end; font-size: var(--step-0); transform: rotate(-2deg); max-inline-size: 26ch; text-align: end; }

  @media (prefers-reduced-motion: no-preference) {
    :global(html.js) .rm__sheet .rm__circle path { stroke-dashoffset: 1; transition: stroke-dashoffset 700ms var(--ease-in-out); }
    :global(html.js) .rm__sheet.is-in .rm__circle path { stroke-dashoffset: 0; }
    :global(html.js) .rm__sheet.is-in tr:nth-child(1) .rm__circle path { transition-delay: 500ms; }
    :global(html.js) .rm__sheet.is-in tr:nth-child(2) .rm__circle path { transition-delay: 700ms; }
    :global(html.js) .rm__sheet.is-in tr:nth-child(3) .rm__circle path { transition-delay: 900ms; }
    :global(html.js) .rm__sheet.is-in tr:nth-child(4) .rm__circle path { transition-delay: 1100ms; }
    :global(html.js) .rm__sheet.is-in tr:nth-child(5) .rm__circle path { transition-delay: 1300ms; }
  }

  /* Entries: one ruled notebook entry per release */
  .rm__list { display: grid; gap: var(--space-6); }
  .rm__entries { display: grid; border-block-start: 1px solid var(--rule-strong); }
  .rm__entry {
    display: grid; gap: var(--space-3); padding-block: var(--space-6);
    border-block-end: 1px solid var(--rule); scroll-margin-block-start: 6rem;
  }
  .rm__entry:target .rm__title { color: var(--accent-ink); }
  .rm__meta { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-3); }
  .rm__meta .chip { font-size: var(--step--1); padding-block: 0.25rem; }
  .rm__date { font-family: var(--font-mono-stack); font-size: var(--step--2); letter-spacing: 0.04em; text-transform: uppercase; color: var(--ink-3); }
  .rm__title { font-size: var(--step-2); line-height: var(--leading-snug); }
  .rm__items { display: grid; gap: var(--space-2); color: var(--ink-2); max-inline-size: var(--measure); }
  .rm__items li { display: grid; grid-template-columns: 1.25rem minmax(0, 1fr); gap: var(--space-2); align-items: baseline; }
  .rm__items :global(.rm__tick) { color: var(--success); translate: 0 0.15em; }
  .rm__more { justify-self: start; }

  @media (max-width: 960px) {
    .rm { grid-template-columns: minmax(0, 1fr); }
    .rm__side { position: static; max-inline-size: 30rem; }
    .rm__sheet { rotate: none; }
  }
  @media (max-width: 560px) {
    .rm__sheet { padding-inline: var(--space-3); }
    .rm__note { justify-self: start; text-align: start; }
    .rm__tag { font-size: 0.6rem; }
  }
</style>
