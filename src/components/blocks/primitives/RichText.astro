---
/**
 * Page-builder Markdown block. The source is untrusted: safe-markdown escapes raw HTML and
 * filters link and image URLs, so set:html only ever receives sanitised output.
 */
import { renderMarkdown } from "~/lib/blocks/safe-markdown";
interface Props { markdown: string; width?: "prose" | "wide" }
const { markdown, width = "prose" } = Astro.props;
const html = renderMarkdown(markdown);
---

<div class:list={["prose", "rt", `rt--${width}`]} data-reveal set:html={html} />

<style>
  .rt--wide { max-inline-size: none; }
  .rt :global(code) { font-family: var(--font-mono-stack, var(--font-mono, monospace)); font-size: 0.92em; }
  .rt :global(:not(pre) > code) { padding: 0.1em 0.35em; border-radius: var(--radius-1, 4px); background: var(--paper-3); color: var(--ink); }
</style>
