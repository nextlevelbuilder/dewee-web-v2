---
/**
 * Story teaser: prose with a pull quote on one side, the dated timeline on the other,
 * like a diary page with dates ruled down the margin.
 */
import SectionHead from "./SectionHead.astro";
import Timeline from "./Timeline.astro";
import Icon from "~/components/ui/Icon.astro";
interface Props {
  eyebrow?: string;
  title: string;
  body: string[];
  quote?: string;
  cta?: { label: string; href: string };
  timeline: { date: string; text: string }[];
  timelineLabel?: string;
}
const { eyebrow, title, body, quote, cta, timeline, timelineLabel } = Astro.props;
---

<div class="story">
  <div class="story__copy">
    <SectionHead eyebrow={eyebrow} title={title} />
    <div class="story__body" data-reveal>
      {body.map((p) => <p>{p}</p>)}
    </div>
    {quote && (
      <blockquote class="story__quote" data-reveal>
        <Icon name="quote" size={28} />
        <p>{quote}</p>
      </blockquote>
    )}
    {cta && <a class="btn btn--ink story__cta" href={cta.href} data-reveal>{cta.label}<Icon name="arrow-right" class="arrow" /></a>}
  </div>
  <div class="story__tl">
    <Timeline items={timeline} vertical label={timelineLabel} />
  </div>
</div>

<style>
  .story { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 4fr); gap: clamp(2.5rem, 1rem + 5vw, 6rem); align-items: start; }
  .story__body { display: grid; gap: var(--space-4); margin-block-start: var(--space-6); color: var(--ink-2); max-inline-size: var(--measure); }
  .story__quote { position: relative; margin-block-start: var(--space-6); padding: var(--space-5) var(--space-5) var(--space-5) var(--space-7); border-inline-start: 3px solid var(--margin-rule); background: var(--paper-2); border-radius: 0 var(--radius-2) var(--radius-2) 0; }
  .story__quote :global(svg) { position: absolute; inset-inline-start: var(--space-4); inset-block-start: var(--space-4); color: var(--margin-rule); }
  .story__quote p { font-family: var(--font-display-stack); font-style: italic; font-size: var(--step-2); line-height: 1.3; color: var(--ink); }
  .story__cta { margin-block-start: var(--space-6); }
  .story__tl { position: sticky; inset-block-start: 7rem; padding: var(--space-6); border-radius: var(--radius-3); border: 1px solid var(--rule); background: var(--surface); box-shadow: var(--shadow-1); }
  @media (max-width: 900px) {
    .story { grid-template-columns: minmax(0, 1fr); }
    .story__tl { position: static; }
  }
  @media (max-width: 560px) {
    .story__quote { padding: var(--space-7) var(--space-4) var(--space-4); }
  }
</style>
