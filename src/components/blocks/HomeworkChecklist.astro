---
/**
 * "We did the homework": a notebook page of ticked items, graded in red pen by the teacher.
 * The ticks draw themselves as the list scrolls in; the grade circle is hand-drawn SVG.
 */
import SectionHead from "./SectionHead.astro";
interface Props {
  eyebrow?: string;
  title: string;
  lede?: string;
  items: { text: string; detail?: string }[];
  grade: string;
  gradeLabel: string;
  signature?: string;
}
const { eyebrow, title, lede, items, grade, gradeLabel, signature } = Astro.props;
---

<section class="section hw">
  <div class="container hw__grid">
    <div class="hw__head"><SectionHead eyebrow={eyebrow} title={title} lede={lede} /></div>
    <div class="hw__page paper-grid" data-reveal>
      <div class="hw__grade" role="img" aria-label={gradeLabel}>
        <span class="hw__grade-num">{grade}</span>
        <svg viewBox="0 0 120 100" aria-hidden="true"><path pathLength="1" d="M70 8 C 30 4 6 30 10 58 C 14 86 52 96 82 88 C 110 80 118 52 104 30 C 94 14 76 8 58 10" /></svg>
      </div>
      <ol class="hw__list" role="list" data-reveal-group>
        {items.map((it) => (
          <li class="hw__item" data-reveal>
            <span class="hw__box" aria-hidden="true"><svg viewBox="0 0 24 24"><path pathLength="1" d="M4 13 L10 18 L21 4" /></svg></span>
            <div>
              <p class="hw__text">{it.text}</p>
              {it.detail && <p class="hw__detail">{it.detail}</p>}
            </div>
          </li>
        ))}
      </ol>
      {signature && <p class="note note--red hw__sign">{signature}</p>}
    </div>
  </div>
</section>

<style>
  .hw__grid { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: clamp(2rem, 1rem + 4vw, 5rem); align-items: start; }
  .hw__head { position: sticky; inset-block-start: 7rem; }
  .hw__page {
    --cell: 9px;
    position: relative;
    background-color: var(--surface);
    border: 1px solid var(--rule); border-radius: var(--radius-2);
    box-shadow: var(--shadow-2);
    padding: var(--space-7) var(--space-6) var(--space-6) calc(var(--space-6) + 3.25rem);
  }
  /* the notebook's pink margin line */
  .hw__page::before {
    content: ""; position: absolute; inset-block: 0; inset-inline-start: 2.75rem; inline-size: 4px;
    border-inline: 1px solid var(--margin-rule); opacity: 0.7;
  }
  .hw__list { display: grid; gap: var(--space-5); }
  .hw__item { display: grid; grid-template-columns: 1.6rem minmax(0, 1fr); gap: var(--space-4); align-items: start; }
  .hw__box {
    position: relative; inline-size: 1.4rem; block-size: 1.4rem; margin-block-start: 0.2rem;
    border: 1.5px solid var(--ink-3); border-radius: 4px; background: var(--surface);
  }
  .hw__box svg { position: absolute; inset: -30% -35% 5% 5%; inline-size: 150%; block-size: 130%; overflow: visible; }
  .hw__box path { fill: none; stroke: var(--accent); stroke-width: 3; stroke-linecap: round; stroke-linejoin: round; stroke-dasharray: 1; stroke-dashoffset: 0; }
  .hw__text { font-weight: 600; color: var(--ink); line-height: 1.4; }
  .hw__detail { margin-block-start: var(--space-1); font-size: var(--step--1); color: var(--ink-3); }

  .hw__grade {
    position: absolute; inset-block-start: -1.75rem; inset-inline-end: -0.75rem;
    inline-size: 6.5rem; block-size: 5.5rem; display: grid; place-items: center;
    color: var(--redpen); transform: rotate(-8deg);
  }
  .hw__grade-num { font-family: var(--font-hand-stack); font-size: var(--step-4); line-height: 1; padding-block-start: 0.2em; }
  .hw__grade svg { position: absolute; inset: 0; inline-size: 100%; block-size: 100%; overflow: visible; }
  .hw__grade path { fill: none; stroke: currentColor; stroke-width: 2.2; stroke-linecap: round; stroke-dasharray: 1; stroke-dashoffset: 0; }
  .hw__sign { margin-block-start: var(--space-6); text-align: end; font-size: var(--step-0); transform: rotate(-2deg); }

  @media (prefers-reduced-motion: no-preference) {
    :global(html.js) .hw__box path { stroke-dashoffset: 1; transition: stroke-dashoffset 420ms var(--ease-out); transition-delay: calc(350ms + var(--reveal-i, 0) * 140ms); }
    :global(html.js) .hw__item.is-in .hw__box path { stroke-dashoffset: 0; }
    :global(html.js) .hw__grade { opacity: 0; transform: rotate(-8deg) scale(1.3); transition: opacity var(--dur-3) var(--ease-out) 1.4s, transform var(--dur-4) var(--ease-spring) 1.4s; }
    :global(html.js) .hw__page.is-in .hw__grade { opacity: 1; transform: rotate(-8deg); }
    :global(html.js) .hw__grade path { stroke-dashoffset: 1; transition: stroke-dashoffset 700ms var(--ease-in-out) 1.6s; }
    :global(html.js) .hw__page.is-in .hw__grade path { stroke-dashoffset: 0; }
  }
  @media (max-width: 900px) {
    .hw__grid { grid-template-columns: minmax(0, 1fr); }
    .hw__head { position: static; }
  }
  @media (max-width: 560px) {
    .hw__page { padding: var(--space-7) var(--space-4) var(--space-5) calc(var(--space-4) + 1.75rem); }
    .hw__page::before { inset-inline-start: 1.1rem; }
    .hw__grade { inline-size: 5rem; block-size: 4.25rem; inset-inline-end: -0.25rem; }
  }
</style>
