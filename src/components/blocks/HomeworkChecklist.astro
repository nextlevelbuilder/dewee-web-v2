---
/**
 * "We did the homework": a sheet of ticked items under the edge of a bronze drum, sealed with a
 * vermilion stamp. The ticks draw themselves as the list scrolls in; the seal is pressed last.
 */
import SectionHead from "./SectionHead.astro";
interface Props {
  eyebrow?: string;
  title: string;
  lede?: string;
  items: { text: string; detail?: string }[];
  grade: string;
  gradeLabel: string;
  signature?: string;
}
const { eyebrow, title, lede, items, grade, gradeLabel, signature } = Astro.props;
---

<section class="section hw">
  <div class="container hw__grid">
    <div class="hw__head"><SectionHead eyebrow={eyebrow} title={title} lede={lede} /></div>
    <div class="hw__page drum-texture" data-reveal>
      <div class="hw__grade seal" role="img" aria-label={gradeLabel}>{grade}</div>
      <ol class="hw__list" role="list" data-reveal-group>
        {items.map((it) => (
          <li class="hw__item" data-reveal>
            <span class="hw__box" aria-hidden="true"><svg viewBox="0 0 24 24"><path pathLength="1" d="M4 13 L10 18 L21 4" /></svg></span>
            <div>
              <p class="hw__text">{it.text}</p>
              {it.detail && <p class="hw__detail">{it.detail}</p>}
            </div>
          </li>
        ))}
      </ol>
      {signature && <p class="note note--seal hw__sign">{signature}</p>}
    </div>
  </div>
</section>

<style>
  /* The seal hangs past the page edge and starts scaled up before its reveal; clip it at the viewport, never scroll. */
  .hw { overflow-x: clip; }
  .hw__grid { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: clamp(2rem, 1rem + 4vw, 5rem); align-items: start; }
  .hw__head { position: sticky; inset-block-start: 7rem; }
  .hw__page {
    --cell: 9px;
    position: relative;
    background-color: var(--surface);
    border: 1px solid var(--rule); border-radius: var(--radius-2);
    box-shadow: var(--shadow-2);
    padding: var(--space-7) var(--space-6) var(--space-6);
  }
  .hw__list { display: grid; gap: var(--space-5); }
  .hw__item { display: grid; grid-template-columns: 1.6rem minmax(0, 1fr); gap: var(--space-4); align-items: start; }
  .hw__box {
    position: relative; inline-size: 1.4rem; block-size: 1.4rem; margin-block-start: 0.2rem;
    border: 1.5px solid var(--ink-3); border-radius: 4px; background: var(--surface);
  }
  .hw__box svg { position: absolute; inset: -30% -35% 5% 5%; inline-size: 150%; block-size: 130%; overflow: visible; }
  .hw__box path { fill: none; stroke: var(--accent); stroke-width: 3; stroke-linecap: round; stroke-linejoin: round; stroke-dasharray: 1; stroke-dashoffset: 0; }
  .hw__text { font-weight: 600; color: var(--ink); line-height: 1.4; }
  .hw__detail { margin-block-start: var(--space-1); font-size: var(--step--1); color: var(--ink-3); }

  .hw__grade {
    --seal-size: 5rem;
    position: absolute; inset-block-start: -1.75rem; inset-inline-end: -0.75rem;
    transform: rotate(-7deg);
  }
  .hw__sign { margin-block-start: var(--space-6); text-align: end; font-size: var(--step-0); transform: rotate(-2deg); }

  @media (prefers-reduced-motion: no-preference) {
    :global(html.js) .hw__box path { stroke-dashoffset: 1; transition: stroke-dashoffset 420ms var(--ease-out); transition-delay: calc(350ms + var(--reveal-i, 0) * 140ms); }
    :global(html.js) .hw__item.is-in .hw__box path { stroke-dashoffset: 0; }
    :global(html.js) .hw__grade { opacity: 0; transform: rotate(-7deg) scale(1.3); transition: opacity var(--dur-3) var(--ease-out) 1.4s, transform var(--dur-4) var(--ease-spring) 1.4s; }
    :global(html.js) .hw__page.is-in .hw__grade { opacity: 1; transform: rotate(-7deg); }
  }
  @media (max-width: 900px) {
    .hw__grid { grid-template-columns: minmax(0, 1fr); }
    .hw__head { position: static; }
    /* Tablet gutters are too thin for the seal to hang past the page edge and stay whole on screen. */
    .hw__grade { inset-inline-end: 0.5rem; }
  }
  @media (max-width: 560px) {
    .hw__page { padding: var(--space-7) var(--space-4) var(--space-5); }
    .hw__grade { --seal-size: 4rem; inset-inline-end: -0.25rem; }
  }
</style>
