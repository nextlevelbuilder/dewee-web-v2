---
/**
 * Gives each plan card rendered by the shared DeployPlans block a stable id (`#saas`,
 * `#dedicated`, `#on-premises`), because other pages deep-link to /pricing#<plan>.
 * DeployPlans has no id prop, so this wraps it and stamps the ids at build time, in card order.
 * No JavaScript is involved, so the anchors also work for crawlers and without scripts.
 * Cards that already carry an id are left alone, so adding an id prop upstream is safe.
 */
interface Props {
  /** Plan ids in the same order as the plans passed to DeployPlans */
  ids: string[];
}
const { ids } = Astro.props;
const html = await Astro.slots.render("default");
let i = 0;
// Matches the opening tag of each plan card (`<li class="plan …">`), not its inner list items.
const stamped = html.replace(/<li class="plan(?=[\s"])[^>]*>/g, (tag) => {
  const id = ids[i++];
  return id && !/\sid="/.test(tag) ? tag.replace("<li ", `<li id="${id}" `) : tag;
});
---

<Fragment set:html={stamped} />
