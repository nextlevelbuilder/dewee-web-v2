---
/**
 * A table of contents written on an index card ("Mục lục"): numbered chapter links with
 * dotted leaders, for the hero aside of long-form pages.
 */
interface Props {
  title: string;
  items: { href: string; title: string; date?: string }[];
}
const { title, items } = Astro.props;
---

<nav class="ci paper-grid" aria-label={title}>
  <p class="ci__title">{title}</p>
  <ol class="ci__list" role="list">
    {items.map((it, i) => (
      <li>
        <a class="ci__link" href={it.href}>
          <span class="ci__n">{i + 1}</span>
          <span class="ci__t">{it.title}</span>
          {it.date && <span class="ci__d">{it.date}</span>}
        </a>
      </li>
    ))}
  </ol>
</nav>

<style>
  .ci {
    --cell: 9px;
    display: grid; gap: var(--space-4); padding: var(--space-6) var(--space-5) var(--space-5);
    background-color: var(--surface); border: 1px solid var(--rule); border-radius: var(--radius-2);
    box-shadow: var(--shadow-2); transform: rotate(1.2deg);
  }
  .ci__title { font-family: var(--font-display-stack); font-style: italic; font-size: var(--step-2); color: var(--ink); line-height: 1; }
  .ci__list { display: grid; }
  .ci__link {
    display: grid; grid-template-columns: 1.5rem minmax(0, 1fr) auto; align-items: baseline; gap: var(--space-2);
    min-block-size: 2.75rem; padding-block: var(--space-2); border-block-end: 1px dashed var(--rule);
    text-decoration: none; color: var(--ink-2);
  }
  .ci__link:hover { color: var(--accent-ink); }
  .ci__n { font-family: var(--font-display-stack); font-style: italic; color: var(--accent-ink); }
  .ci__t { font-size: var(--step--1); line-height: 1.4; }
  .ci__d { font-family: var(--font-mono-stack); font-size: var(--step--2); color: var(--ink-3); white-space: nowrap; }
  @media (prefers-reduced-motion: no-preference) {
    .ci { transition: transform var(--dur-3) var(--ease-spring); }
    .ci:hover { transform: rotate(0); }
  }
</style>
