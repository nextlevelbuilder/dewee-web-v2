---
/**
 * Partner tiers drawn as a chalk staircase on the blackboard: each step sits higher than the
 * last, with its name, the margin in large chalk figures, the minimum deposit and its perks.
 * Steps climb in from the left one after another. On narrow screens the staircase becomes a list.
 */
interface Props {
  label: string;
  depositLabel: string;
  marginLabel: string;
  tiers: { name: string; deposit: string; margin: string; perks: string[] }[];
}
const { label, depositLabel, marginLabel, tiers } = Astro.props;
---

<ol class="ladder" role="list" aria-label={label} data-reveal-group style={`--n:${tiers.length}`}>
  {tiers.map((t, i) => (
    <li class="ladder__step" style={`--i:${i}`} data-reveal>
      <p class="ladder__name">{t.name}</p>
      <p class="ladder__margin"><span class="ladder__pct">{t.margin}</span><span class="ladder__cap">{marginLabel}</span></p>
      <p class="ladder__deposit"><span class="ladder__cap">{depositLabel}</span> <b>{t.deposit}</b></p>
      <ul class="ladder__perks" role="list">{t.perks.map((p) => <li>{p}</li>)}</ul>
    </li>
  ))}
</ol>

<style>
  .ladder { display: grid; grid-template-columns: repeat(var(--n), minmax(0, 1fr)); align-items: stretch; gap: var(--space-3); }
  .ladder__step {
    display: grid; gap: var(--space-3); align-content: start;
    /* each step rises above the last */
    margin-block-start: calc((var(--n) - 1 - var(--i)) * 2.75rem);
    padding: var(--space-5) var(--space-4) var(--space-6);
    border: 1.5px solid var(--rule-strong); border-block-end: 0; border-radius: 6px 6px 0 0;
    background: color-mix(in oklch, var(--surface) 70%, transparent);
    position: relative;
  }
  .ladder__step::after {
    /* chalk floor line under the whole staircase */
    content: ""; position: absolute; inset-inline: calc(var(--space-3) * -0.5); inset-block-end: 0; block-size: 2px; background: var(--ink-3); opacity: 0.6;
  }
  .ladder__step:last-child { border-color: var(--accent); }
  .ladder__name { font-family: var(--font-mono-stack); font-size: var(--step--2); letter-spacing: var(--tracking-caps); text-transform: uppercase; color: var(--accent-ink); }
  .ladder__margin { display: grid; gap: 0.1rem; }
  .ladder__pct { font-family: var(--font-hand-stack); font-weight: 300; font-size: var(--step-5); line-height: 1.3; color: var(--ink); }
  .ladder__cap { font-size: var(--step--2); color: var(--ink-3); }
  .ladder__deposit { font-size: var(--step--1); color: var(--ink-2); }
  .ladder__deposit b { color: var(--ink); font-weight: 600; }
  .ladder__perks { display: grid; gap: var(--space-2); padding-block-start: var(--space-3); border-block-start: 1px dashed var(--rule); font-size: var(--step--1); color: var(--ink-2); line-height: 1.45; }
  .ladder__perks li { padding-inline-start: 1rem; position: relative; }
  .ladder__perks li::before { content: "–"; position: absolute; inset-inline-start: 0; color: var(--accent-ink); }

  @media (max-width: 900px) {
    .ladder { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .ladder__step { margin-block-start: 0; border: 1.5px solid var(--rule-strong); border-radius: var(--radius-2); }
    .ladder__step::after { display: none; }
  }
  @media (max-width: 520px) {
    .ladder { grid-template-columns: minmax(0, 1fr); }
  }
</style>
