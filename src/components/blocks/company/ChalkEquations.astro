---
/**
 * Working written on the blackboard: a few lines of "equations" in chalk handwriting, each with
 * a small margin remark, ending in a boxed "∴" conclusion. Meant for a `.board` surface, where
 * the ink tokens already read as chalk. Lines write themselves in (clip reveal) one by one: the
 * observed element is the unclipped line, and only its inner text is clipped, because an element
 * clipped to nothing never reports as intersecting and would stay hidden.
 */
interface Props {
  label: string;
  lines: { lhs: string; rhs: string; note?: string }[];
  result: string;
}
const { label, lines, result } = Astro.props;
---

<figure class="eq" aria-label={label}>
  <ol class="eq__lines" role="list" data-reveal-group>
    {lines.map((l) => (
      <li class="eq__line" data-reveal>
        <span class="eq__ink">
          <span class="eq__lhs">{l.lhs}</span>
          <span class="eq__op" aria-hidden="true">=</span>
          <span class="eq__rhs">{l.rhs}</span>
          {l.note && <span class="eq__note">({l.note})</span>}
        </span>
      </li>
    ))}
  </ol>
  <p class="eq__result" data-reveal><span class="eq__therefore" aria-hidden="true">∴</span>{result}</p>
</figure>

<style>
  .eq { margin: 0; display: grid; gap: var(--space-6); }
  .eq__lines { display: grid; gap: var(--space-5); }
  .eq__line {
    padding-block-end: var(--space-4); border-block-end: 1px dashed var(--rule);
    font-family: var(--font-hand-stack); font-weight: 300; font-size: var(--step-1); line-height: 1.7; color: var(--ink);
  }
  .eq__ink { display: flex; flex-wrap: wrap; align-items: baseline; gap: var(--space-2) var(--space-4); }
  .eq__op { font-family: var(--font-display-stack); font-size: var(--step-3); line-height: 1; color: var(--accent-ink); }
  .eq__rhs { text-decoration: underline; text-decoration-color: color-mix(in oklch, var(--accent) 70%, transparent); text-decoration-thickness: 2px; text-underline-offset: 0.35em; }
  .eq__note { font-size: var(--step--1); color: var(--ink-3); }
  .eq__result {
    justify-self: start; display: flex; gap: var(--space-3); align-items: baseline;
    padding: var(--space-4) var(--space-5); border: 2px solid var(--redpen); border-radius: 18px 10px 20px 8px / 10px 18px 8px 20px;
    font-family: var(--font-display-stack); font-size: var(--step-2); line-height: 1.3; color: var(--ink); max-inline-size: 40rem;
  }
  .eq__therefore { color: var(--redpen); font-size: var(--step-3); line-height: 1; }
  @media (prefers-reduced-motion: no-preference) {
    :global(html.js) .eq__ink { clip-path: inset(0 100% 0 0); transition: clip-path 1100ms var(--ease-in-out); transition-delay: calc(var(--reveal-i, 0) * 120ms + 200ms); }
    :global(html.js) .eq__line:global(.is-in) .eq__ink { clip-path: inset(0 0 0 0); }
  }
  @media (max-width: 560px) {
    .eq__line { font-size: var(--step-0); }
    .eq__result { font-size: var(--step-1); padding: var(--space-3) var(--space-4); }
  }
</style>
