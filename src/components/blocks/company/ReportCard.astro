---
/**
 * "Học bạ": a Vietnamese school report card. A ruled table of subjects with evidence, a grade
 * circled in red pen and the teacher's remark, then the conduct line and a signature.
 * Grades pop in after the card scrolls into view; on phones each subject becomes its own block.
 */
interface Props {
  label: string;
  title: string;
  meta: { label: string; value: string }[];
  columns: { subject: string; evidence: string; grade: string; remark: string };
  rows: { subject: string; evidence: string; grade: string; remark: string }[];
  conduct?: { label: string; value: string };
  sign?: string;
}
const { label, title, meta, columns, rows, conduct, sign } = Astro.props;
---

<figure class="rc drum-texture" aria-label={label} data-reveal>
  <header class="rc__head">
    <p class="rc__title">{title}</p>
    <dl class="rc__meta">
      {meta.map((m) => (
        <div><dt>{m.label}</dt><dd>{m.value}</dd></div>
      ))}
    </dl>
  </header>
  <table class="rc__table">
    <thead>
      <tr>
        <th scope="col">{columns.subject}</th>
        <th scope="col">{columns.evidence}</th>
        <th scope="col" class="rc__gcol">{columns.grade}</th>
        <th scope="col">{columns.remark}</th>
      </tr>
    </thead>
    <tbody>
      {rows.map((r, i) => (
        <tr style={`--i:${i}`}>
          <th scope="row" class="rc__subject">{r.subject}</th>
          <td class="rc__evidence">{r.evidence}</td>
          <td class="rc__grade"><span class="seal">{r.grade}</span></td>
          <td class="rc__remark">{r.remark}</td>
        </tr>
      ))}
    </tbody>
  </table>
  {(conduct || sign) && (
    <footer class="rc__foot">
      {conduct && <p class="rc__conduct"><span>{conduct.label}:</span> <b>{conduct.value}</b></p>}
      {sign && <p class="rc__sign">{sign}</p>}
    </footer>
  )}
</figure>

<style>
  .rc {
    --cell: 9px;
    position: relative; margin: 0; display: grid; gap: var(--space-5);
    padding: clamp(1.5rem, 1rem + 2.5vw, 3rem) clamp(1.25rem, 0.5rem + 3vw, 3rem);
    background-color: var(--surface); border: 1px solid var(--rule); border-radius: var(--radius-2); box-shadow: var(--shadow-3);
    /* a double frame, like the printed border of a report card */
    outline: 1px solid var(--rule-strong); outline-offset: -0.6rem;
  }
  .rc__head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: end; gap: var(--space-4); padding-block-end: var(--space-4); border-block-end: 2px solid var(--ink); }
  .rc__title { font-family: var(--font-display-stack); font-size: var(--step-4); line-height: 1; color: var(--ink); text-transform: uppercase; letter-spacing: 0.04em; }
  .rc__meta { display: flex; flex-wrap: wrap; gap: var(--space-2) var(--space-5); font-size: var(--step--1); }
  .rc__meta div { display: flex; gap: 0.4em; }
  .rc__meta dt { color: var(--ink-3); }
  .rc__meta dt::after { content: ":"; }
  .rc__meta dd { font-family: var(--font-sign-stack); font-weight: 400; font-size-adjust: var(--font-sign-adjust); color: var(--accent-ink); }

  .rc__table { inline-size: 100%; font-size: var(--step--1); line-height: 1.55; }
  .rc__table th, .rc__table td { padding: var(--space-4) var(--space-3); text-align: start; vertical-align: middle; border-block-end: 1px solid var(--rule); }
  .rc__table thead th { font-family: var(--font-mono-stack); font-size: var(--step--2); font-weight: 500; letter-spacing: 0.06em; text-transform: uppercase; color: var(--ink-3); border-block-end: 1.5px solid var(--rule-strong); padding-block: var(--space-2); }
  .rc__subject { font-family: var(--font-display-stack); font-size: var(--step-1); font-weight: 500; color: var(--ink); inline-size: 22%; line-height: 1.25; }
  .rc__evidence { color: var(--ink-2); }
  .rc__table .rc__gcol, .rc__table .rc__grade { text-align: center; inline-size: 5.5rem; }
  .rc__grade span { --seal-size: 3rem; border-width: 2px; outline-offset: -6px; outline-width: 1px; transform: rotate(-6deg); }
  .rc__remark { font-family: var(--font-sign-stack); font-weight: 400; font-size-adjust: var(--font-sign-adjust); color: var(--seal); inline-size: 24%; line-height: 1.7; }

  .rc__foot { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: var(--space-3); }
  .rc__conduct { font-size: var(--step--1); color: var(--ink-3); }
  .rc__conduct b { font-family: var(--font-sign-stack); font-weight: 400; font-size-adjust: var(--font-sign-adjust); font-size: var(--step-1); color: var(--seal); }
  .rc__sign { font-family: var(--font-sign-stack); font-weight: 400; font-size-adjust: var(--font-sign-adjust); font-size: var(--step-0); color: var(--accent-ink); transform: rotate(-2deg); }

  @media (prefers-reduced-motion: no-preference) {
    :global(html.js) .rc__grade span { opacity: 0; transform: rotate(-6deg) scale(1.5); transition: opacity var(--dur-3) var(--ease-out), transform var(--dur-4) var(--ease-spring); transition-delay: calc(700ms + var(--i, 0) * 220ms); }
    :global(html.js) .rc.is-in .rc__grade span { opacity: 1; transform: rotate(-6deg); }
  }

  @media (max-width: 720px) {
    .rc__table thead { position: absolute; inline-size: 1px; block-size: 1px; overflow: hidden; clip: rect(0 0 0 0); }
    .rc__table, .rc__table tbody, .rc__table tr { display: block; }
    .rc__table tr { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: var(--space-2) var(--space-3); padding-block: var(--space-4); border-block-end: 1px solid var(--rule); }
    .rc__table th, .rc__table td { padding: 0; border: 0; inline-size: auto; }
    .rc__subject { grid-column: 1; grid-row: 1; }
    .rc__grade { grid-column: 2; grid-row: 1 / span 2; align-self: start; }
    .rc__evidence { grid-column: 1; }
    .rc__remark { grid-column: 1 / -1; }
  }
</style>
