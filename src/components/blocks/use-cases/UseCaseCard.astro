---
/**
 * One use case as a notebook exercise card: exercise number, team with an icon tinted by the
 * kind of work (`--area`), title, summary and the channels it runs on. The whole card is
 * clickable through a stretched title link, so there is exactly one link per card.
 */
import Icon from "~/components/ui/Icon.astro";
import BrandMark from "~/components/ui/BrandMark.astro";
import type { IconName } from "~/components/ui/icon-paths";

interface Props {
  href: string;
  icon: IconName;
  team: string;
  title: string;
  summary: string;
  channels: { brand: string; name: string }[];
  /** Accessible label for the channel list, e.g. "Runs on" */
  channelsLabel: string;
  /** Decorative call to action shown at the bottom of the card */
  readLabel: string;
  /** Exercise number, e.g. "07" */
  no?: string;
  /** Inline `--area: var(--token)` style from area-accent.ts */
  accent?: string;
  level?: 2 | 3;
}
const { href, icon, team, title, summary, channels, channelsLabel, readLabel, no, accent, level = 3 } = Astro.props;
const Tag = `h${level}` as "h2" | "h3";
---

<article class="card card--link uc" style={accent}>
  <header class="uc__top">
    <span class="uc__icon" aria-hidden="true"><Icon name={icon} size={20} /></span>
    <span class="uc__team">{team}</span>
    {no && <span class="uc__no mono" aria-hidden="true">{no}</span>}
  </header>
  <Tag class="uc__title"><a class="uc__link" href={href}>{title}</a></Tag>
  <p class="uc__summary">{summary}</p>
  <footer class="uc__foot">
    <ul class="uc__channels" role="list" aria-label={channelsLabel}>
      {channels.map((c) => (
        <li title={c.name}><BrandMark brand={c.brand} name={c.name} size={18} /><span class="sr-only">{c.name}</span></li>
      ))}
    </ul>
    <span class="uc__read" aria-hidden="true">{readLabel}<Icon name="arrow-right" size={16} class="arrow" /></span>
  </footer>
</article>

<style>
  .uc {
    --area: var(--accent);
    display: grid; grid-template-rows: auto auto 1fr auto; gap: var(--space-3);
    block-size: 100%; padding: var(--space-5) var(--space-5) var(--space-4);
  }
  .uc__top { display: flex; align-items: center; gap: var(--space-2); min-inline-size: 0; }
  .uc__icon {
    display: grid; place-items: center; flex: none; inline-size: 2.25rem; block-size: 2.25rem; border-radius: var(--radius-2);
    background: color-mix(in oklch, var(--area) 16%, var(--surface));
    color: color-mix(in oklch, var(--area) 70%, var(--ink));
  }
  .uc__team {
    min-inline-size: 0; font-family: var(--font-mono-stack); font-size: var(--step--2); font-weight: 500;
    letter-spacing: var(--tracking-caps); text-transform: uppercase; color: var(--ink-3);
  }
  .uc__no { margin-inline-start: auto; font-size: var(--step--2); color: var(--ink-3); }
  .uc__title { font-size: var(--step-1); line-height: 1.25; text-wrap: balance; }
  .uc__link { color: inherit; text-decoration: none; }
  /* The ::after below makes the whole card the tap target; on narrow screens the link's own box
     is also padded to 44px (negative margins keep the layout unchanged). */
  @media (max-width: 640px) {
    .uc__link { display: inline-block; padding-block: 0.75rem; margin-block: -0.75rem; }
  }
  .uc__link::after { content: ""; position: absolute; inset: 0; border-radius: inherit; }
  .uc__link:focus-visible { outline: none; }
  .uc:has(.uc__link:focus-visible) { outline: 2px solid var(--focus, var(--accent)); outline-offset: 3px; }
  .uc__summary { font-size: var(--step--1); line-height: 1.6; color: var(--ink-2); }
  .uc__foot {
    display: flex; align-items: center; justify-content: space-between; gap: var(--space-3);
    padding-block-start: var(--space-3); border-block-start: 1px dashed var(--rule);
  }
  .uc__channels { display: flex; flex-wrap: wrap; gap: var(--space-2); color: var(--ink-3); }
  .uc__channels li { display: inline-flex; }
  .uc__read {
    display: inline-flex; align-items: center; gap: 0.3rem; flex: none;
    font-size: var(--step--1); font-weight: 600; color: var(--accent-ink);
  }
  .uc__read :global(.arrow) { transition: transform var(--dur-2) var(--ease-out); }
  .uc:hover .uc__read :global(.arrow) { transform: translateX(3px); }
  .uc:hover .uc__title { color: var(--accent-ink); }

  @media (prefers-reduced-motion: reduce) {
    .uc:hover .uc__read :global(.arrow) { transform: none; }
  }
</style>
