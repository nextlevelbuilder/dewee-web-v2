---
/** One icon family (Lucide), one stroke width. Decorative unless `label` is set. */
import { ICONS, type IconName } from "./icon-paths";
interface Props { name: IconName; size?: number | string; label?: string; class?: string; stroke?: number }
const { name, size = "1em", label, class: className, stroke = 1.75 } = Astro.props;
const body = ICONS[name] ?? "";
---
<svg
  class:list={["icon", className]}
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={stroke}
  stroke-linecap="round"
  stroke-linejoin="round"
  role={label ? "img" : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : "true"}
  focusable="false"
  set:html={body}
/>
