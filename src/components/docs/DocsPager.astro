---
/** Previous / next page links at the foot of a docs article: the page's next step. */
import Icon from "~/components/ui/Icon.astro";
import type { DocsPagerLink } from "./docs-types";

interface Props { prev?: DocsPagerLink; next?: DocsPagerLink; labels: { previous: string; next: string } }
const { prev, next, labels } = Astro.props;
---

{(prev || next) && (
  <nav class="dpager" aria-label={`${labels.previous} / ${labels.next}`}>
    {prev ? (
      <a class="dpager__link dpager__link--prev" href={prev.url} rel="prev">
        <span class="dpager__dir"><Icon name="arrow-left" size={14} />{labels.previous}</span>
        <span class="dpager__title">{prev.title}</span>
        <span class="dpager__section">{prev.section}</span>
      </a>
    ) : <span aria-hidden="true"></span>}
    {next && (
      <a class="dpager__link dpager__link--next" href={next.url} rel="next">
        <span class="dpager__dir">{labels.next}<Icon name="arrow-right" size={14} /></span>
        <span class="dpager__title">{next.title}</span>
        <span class="dpager__section">{next.section}</span>
      </a>
    )}
  </nav>
)}

<style>
  .dpager { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-4); }
  .dpager__link {
    display: grid; gap: var(--space-1); padding: var(--space-4) var(--space-5); border: 1px solid var(--rule); border-radius: var(--radius-3);
    background: var(--surface); color: var(--ink); text-decoration: none; box-shadow: var(--shadow-1);
    transition: border-color var(--dur-2) var(--ease-out), transform var(--dur-2) var(--ease-out), box-shadow var(--dur-2) var(--ease-out);
  }
  .dpager__link:hover { border-color: var(--accent); transform: translateY(-2px); box-shadow: var(--shadow-2); }
  .dpager__link--next { text-align: end; justify-items: end; }
  .dpager__dir {
    display: inline-flex; align-items: center; gap: var(--space-1); font-family: var(--font-mono-stack); font-size: var(--step--2);
    letter-spacing: var(--tracking-caps); text-transform: uppercase; color: var(--accent-ink);
  }
  .dpager__title { font-family: var(--font-display-stack); font-size: var(--step-1); line-height: 1.25; }
  .dpager__section { font-size: var(--step--2); color: var(--ink-3); }
  @media (max-width: 560px) {
    .dpager { grid-template-columns: minmax(0, 1fr); }
    .dpager > span[aria-hidden] { display: none; }
  }
</style>
