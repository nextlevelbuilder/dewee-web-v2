    // Delegated click tracking for conversion-relevant links and controls.
    document.addEventListener("click", function (event) {
      var target = event.target instanceof Element ? event.target : null;
      if (!target) return;
      if (target.closest("[data-theme-toggle]")) {
        setTimeout(function () { posthog.capture("theme_toggled", { theme: document.documentElement.dataset.theme }); }, 0);
        return;
      }
      if (target.closest("[data-chat-toggle], [data-open-chat]")) { posthog.capture("chat_opened"); }
      var link = target.closest("a[href]");
      if (!link) return;
      var url = new URL(link.href, location.href);
      var props = {
        href: url.href,
        text: (link.textContent || "").trim().slice(0, 80),
        location: link.closest("header") ? "nav" : link.closest("footer") ? "footer" : (link.closest("section") || {}).id || "main",
