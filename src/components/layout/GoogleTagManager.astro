---
/**
 * Google Tag Manager with Consent Mode v2. Every storage type starts "denied", so tags run
 * cookieless until the visitor presses "Accept" on the cookie notice (CookieBadge stores
 * `dewee.cookies = "all"` and sends the consent update). Loaded on production only, so
 * staging traffic never reaches the container.
 *   part="head": consent defaults + the GTM loader, as high in <head> as possible
 *   part="body": the <noscript> fallback, right after <body>
 * Named clicks reach the container as dataLayer events, so GTM tags (still bound by Consent Mode)
 * can use them: `hero_cta_clicked` {cta, locale} from `data-hero-cta`, and `app_cta_clicked`
 * {location, locale} for any link into app.dewee.sh. Both add `h1_variant` while the homepage H1
 * experiment enrolls the visitor (docs/experiments/homepage-h1.md); consent gating is the
 * experiment's own, so the key is absent otherwise.
 */
import { SITE } from "~/content/site";
import { H1_VARIANT_DATASET_KEY } from "~/lib/hero-h1-experiment";
interface Props { part: "head" | "body" }
const { part } = Astro.props;
const id = SITE.gtmId;
const appHost = new URL(SITE.appUrl).hostname;
const variantKey = H1_VARIANT_DATASET_KEY;
const enabled = (Astro.site?.hostname ?? "") === SITE.domain;
---

{enabled && part === "head" && (
  <script is:inline define:vars={{ id, appHost, variantKey }}>
    window.dataLayer = window.dataLayer || [];
    // Global so the cookie notice can send the consent update later.
    window.gtag = window.gtag || function () { window.dataLayer.push(arguments); };
    var granted = false;
    try { granted = localStorage.getItem("dewee.cookies") === "all"; } catch (e) {}
    var state = granted ? "granted" : "denied";
    window.gtag("consent", "default", { analytics_storage: state, ad_storage: state, ad_user_data: state, ad_personalization: state, wait_for_update: 500 });
    (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
    new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
    j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
    'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
    })(window,document,'script','dataLayer',id);

    document.addEventListener("click", function (event) {
      var target = event.target instanceof Element ? event.target : null;
      var link = target && target.closest("a[href]");
      if (!link) return;
      var locale = document.documentElement.lang || "en";
      var h1Variant = document.documentElement.dataset[variantKey];
      var heroCta = link.getAttribute("data-hero-cta");
      if (heroCta === "primary" || heroCta === "secondary") {
        var heroEvent = { event: "hero_cta_clicked", cta: heroCta, locale: locale };
        if (h1Variant) heroEvent.h1_variant = h1Variant;
        window.dataLayer.push(heroEvent);
      }
      var url;
      try { url = new URL(link.href, location.href); } catch (e) { return; }
      if (url.hostname === appHost) {
        var where = link.closest("header") ? "nav" : link.closest("footer") ? "footer" : (link.closest("section") || {}).id || "main";
        var appEvent = { event: "app_cta_clicked", location: where, locale: locale };
        if (h1Variant) appEvent.h1_variant = h1Variant;
        window.dataLayer.push(appEvent);
      }
    }, { capture: true });
  </script>
)}
{enabled && part === "body" && (
  <noscript><iframe src={`https://www.googletagmanager.com/ns.html?id=${id}`} height="0" width="0" style="display:none;visibility:hidden" title="Google Tag Manager"></iframe></noscript>
)}
