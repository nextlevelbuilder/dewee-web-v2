---
/**
 * Everything a crawler, a social card or an agent needs to understand a page:
 * title/description, canonical + hreflang, Open Graph/Twitter, Markdown alternate,
 * and truthful JSON-LD (organization, website, breadcrumbs, plus page-specific nodes).
 */
import { LOCALE_META, localePath, type Locale } from "~/i18n/config";
import { SITE, SOCIAL } from "~/content/site";

interface Props {
  title: string;
  description: string;
  locale: Locale;
  /** Unprefixed path, e.g. "/features" */
  path: string;
  ogImage?: string;
  type?: "website" | "article";
  noindex?: boolean;
  /** false when the page exists in only one locale */
  bilingual?: boolean;
  jsonLd?: Record<string, unknown>[];
  breadcrumbs?: { name: string; path: string }[];
  published?: string;
  modified?: string;
}

const {
  title,
  description,
  locale,
  path,
  ogImage,
  type = "website",
  noindex = false,
  bilingual = true,
  jsonLd = [],
  breadcrumbs = [],
  published,
  modified,
} = Astro.props;

const site = (Astro.site?.toString() ?? SITE.url).replace(/\/$/, "");
const canonicalPath = localePath(locale, path);
const canonical = `${site}${canonicalPath}`;
const mdPath = canonicalPath === "/" ? "/index.md" : `${canonicalPath}.md`;
const fullTitle = path === "/" ? title : `${title} · dewee`;
const ogSlug = path === "/" ? "index" : path.replace(/^\//, "").replace(/\//g, "--");
const og = ogImage ? (ogImage.startsWith("http") ? ogImage : `${site}${ogImage}`) : `${site}/og/${locale}/${ogSlug}.png`;

const org = {
  "@type": "Organization",
  "@id": `${SITE.ownerUrl}#org`,
  name: "NextLevelBuilder",
  alternateName: "NextLevelBuilder.io",
  url: SITE.ownerUrl,
  email: SITE.email,
  logo: `${site}/brand/dewee-icon-144.png`,
  sameAs: [SOCIAL.github.href, SOCIAL.x.href, SOCIAL.facebook.target, SOCIAL.discord.target],
};
const website = {
  "@type": "WebSite",
  "@id": `${site}/#website`,
  name: "dewee",
  url: site,
  inLanguage: LOCALE_META[locale].htmlLang,
  publisher: { "@id": `${SITE.ownerUrl}#org` },
};
const crumbs = breadcrumbs.length
  ? [{
      "@type": "BreadcrumbList",
      itemListElement: [{ name: "dewee", path: "/" }, ...breadcrumbs].map((b, i) => ({
        "@type": "ListItem",
        position: i + 1,
        name: b.name,
        item: `${site}${localePath(locale, b.path)}`,
      })),
    }]
  : [];
const graph = { "@context": "https://schema.org", "@graph": [org, website, ...crumbs, ...jsonLd] };
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex, nofollow" />}
{bilingual && (
  <>
    <link rel="alternate" hreflang="en" href={`${site}${localePath("en", path)}`} />
    <link rel="alternate" hreflang="vi" href={`${site}${localePath("vi", path)}`} />
    <link rel="alternate" hreflang="x-default" href={`${site}${localePath("en", path)}`} />
  </>
)}
<link rel="alternate" type="text/markdown" href={mdPath} title="Markdown" />
<link rel="alternate" type="text/plain" href="/llms.txt" title="llms.txt" />

<meta property="og:site_name" content="dewee" />
<meta property="og:type" content={type} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={og} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={title} />
<meta property="og:locale" content={LOCALE_META[locale].ogLocale} />
<meta property="og:locale:alternate" content={LOCALE_META[locale === "en" ? "vi" : "en"].ogLocale} />
{published && <meta property="article:published_time" content={published} />}
{modified && <meta property="article:modified_time" content={modified} />}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content="@nlb_io" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={og} />

<script type="application/ld+json" set:html={JSON.stringify(graph).replace(/</g, "\\u003c")} />
