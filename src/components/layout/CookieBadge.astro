---
/**
 * Informational cookie notice. dewee only sets essential cookies (theme is localStorage,
 * admin session is strictly necessary), so there is nothing to opt into — just a note.
 */
import { localePath, type Locale } from "~/i18n/config";
import { t } from "~/i18n/ui";
import Icon from "~/components/ui/Icon.astro";
interface Props { locale: Locale }
const { locale } = Astro.props;
---

<div class="cookie" role="region" aria-label="Cookies" data-cookie hidden>
  <Icon name="cookie" size={20} class="cookie__icon" />
  <p>
    {t(locale, "cookieText")}
    <a href={localePath(locale, "/cookies")}>{t(locale, "cookieDetails")}</a>
  </p>
  <button type="button" class="btn btn--ink btn--sm" data-cookie-ok>{t(locale, "cookieOk")}</button>
</div>

<style>
  .cookie {
    position: fixed; z-index: var(--z-toast); inset-inline-start: var(--space-4); inset-block-end: var(--space-4);
    display: flex; align-items: center; gap: var(--space-3); max-inline-size: min(30rem, calc(100vw - 2 * var(--space-4) - 4.5rem));
    padding: var(--space-3) var(--space-3) var(--space-3) var(--space-4); border-radius: var(--radius-3);
    background: var(--surface); border: 1px solid var(--rule); box-shadow: var(--shadow-2);
    font-size: var(--step--2); line-height: var(--leading-snug); color: var(--ink-2);
    animation: cookie-in var(--dur-4) var(--ease-out) both;
  }
  .cookie[hidden] { display: none; }
  .cookie :global(.cookie__icon) { flex: none; color: var(--accent-ink); }
  .cookie p { margin: 0; }
  .cookie a { color: var(--ink); margin-inline-start: 0.25rem; }
  .cookie .btn { flex: none; }
  @keyframes cookie-in { from { opacity: 0; transform: translateY(12px); } }
  @media (max-width: 520px) {
    .cookie { inset-inline-start: var(--space-3); inset-block-end: var(--space-3); max-inline-size: calc(100vw - 2 * var(--space-3) - 4.25rem); padding: var(--space-2) var(--space-2) var(--space-2) var(--space-3); }
    .cookie :global(.cookie__icon) { display: none; }
  }
  @media (prefers-reduced-motion: reduce) { .cookie { animation: none; } }
</style>

<script>
  const KEY = "dewee.cookies";
  const el = document.querySelector<HTMLElement>("[data-cookie]");
  let seen = false;
  try { seen = localStorage.getItem(KEY) === "ok"; } catch { seen = false; }
  if (el && !seen) {
    // Wait until the visitor has moved past the first screen so the notice never covers the
    // hero's call to action; pages too short to scroll show it after a short pause instead.
    const show = () => { el.hidden = false; removeEventListener("scroll", onScroll); };
    const onScroll = () => { if (scrollY > innerHeight * 0.6) show(); };
    if (document.documentElement.scrollHeight < innerHeight * 1.6) setTimeout(show, 2500);
    else addEventListener("scroll", onScroll, { passive: true });
    el.querySelector("[data-cookie-ok]")?.addEventListener("click", () => {
      try { localStorage.setItem(KEY, "ok"); } catch { /* still hide for this page */ }
      el.hidden = true;
    });
  }
</script>
