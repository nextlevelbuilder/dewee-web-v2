---
/** Policies (refunds, licences, packages, security reports); /policy#refunds is linked from /pricing (EN + VI). Copy: src/content/legal/policy.ts; layout: LegalLayout. */
import LegalLayout from "~/layouts/LegalLayout.astro";
import { langPaths, type Locale } from "~/i18n/config";
import { POLICY } from "~/content/legal/policy";

export const prerender = true;
export const getStaticPaths = () => langPaths();

const { locale } = Astro.props as { locale: Locale };
---

<LegalLayout locale={locale} slug="policy" doc={POLICY} />
