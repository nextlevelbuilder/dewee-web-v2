---
/**
 * Homepage, outcome first: the promise, one complete piece of work done by people and agents
 * together, why that matters, where it applies, the real console, what it connects to, the
 * security and engineering proof, pricing, questions, and the team behind it last.
 * Copy lives in src/content/pages/home*.ts; every section is a reusable block.
 */
import BaseLayout from "~/layouts/BaseLayout.astro";
import { langPaths, localePath, pick, type Locale } from "~/i18n/config";
import { SITE } from "~/content/site";
import { HOME, HOME_H1_CATEGORY, HOME_UI, HOME_USE_CASE_SLUGS, HOME_WORKFLOW, HOME_WORKFLOW_ANCHOR } from "~/content/pages/home";
import { useCaseBySlug, type UseCase } from "~/content/use-cases";
import { CHANNELS, PROVIDERS } from "~/content/integrations";
import { ccpShotProps } from "~/content/ccp-screens";
import { plansFor } from "~/content/plans";
import { earlyAccessBlock } from "~/content/early-access";
import { faqJsonLd, productJsonLd } from "~/lib/json-ld";
import Icon from "~/components/ui/Icon.astro";
import type { IconName } from "~/components/ui/icon-paths";
import SectionHead from "~/components/blocks/SectionHead.astro";
import HomeHero from "~/components/blocks/HomeHero.astro";
import { H1_TEST_ENABLED } from "~/lib/hero-h1-experiment";
import MultiplayerWorkflow from "~/components/blocks/MultiplayerWorkflow.astro";
import FeatureGrid from "~/components/blocks/FeatureGrid.astro";
import TocIndex from "~/components/blocks/TocIndex.astro";
import CcpShot from "~/components/blocks/CcpShot.astro";
import LogoWall from "~/components/blocks/LogoWall.astro";
import SecurityLayers from "~/components/blocks/SecurityLayers.astro";
import HomeworkChecklist from "~/components/blocks/HomeworkChecklist.astro";
import DeployPlans from "~/components/blocks/DeployPlans.astro";
import Faq from "~/components/blocks/Faq.astro";
import EarlyAccess from "~/components/blocks/EarlyAccess.astro";
import CtaBand from "~/components/blocks/CtaBand.astro";

export const prerender = true;
export const getStaticPaths = () => langPaths();

const { locale } = Astro.props as { locale: Locale };
const t = pick(HOME, locale);
const ui = pick(HOME_UI, locale);
const story = pick(HOME_WORKFLOW, locale);
const href = (p: string) => localePath(locale, p);
// home.test.ts guarantees every curated slug exists; the filter only keeps the type honest.
const homeUseCases = HOME_USE_CASE_SLUGS.map(useCaseBySlug).filter((u): u is UseCase => Boolean(u));
const plans = plansFor(locale).map((p) => ({
  id: p.id,
  icon: p.icon,
  name: pick(p.name, locale),
  price: pick(p.price, locale),
  period: pick(p.period, locale),
  tagline: pick(p.tagline, locale),
  includes: pick(p.includes, locale),
  tradeoffs: pick(p.tradeoffs, locale),
  cta: { label: pick(p.cta, locale), href: href(p.ctaPath ?? `/pricing#${p.id}`) },
  highlight: p.highlight,
  priceUsd: p.priceUsd,
}));
// Vietnam is offered Self-install and On-Premises only (DESIGN.md pricing rule), while app.dewee.sh
// provisions a hosted workspace, so the VI "start" CTAs open the free self-install guide instead.
const startHref = locale === "vi" ? href("/install") : SITE.appUrl;
const earlyAccess = earlyAccessBlock(locale, { cta: `${href("/contact")}?plan=self-hosted`, secondary: href("/install") });
const jsonLd = [
  productJsonLd({ description: t.meta.description, url: `${SITE.url}${href("/")}`, offers: plans.map((p) => ({ name: p.name, price: String(p.priceUsd) })) }),
  faqJsonLd(t.faq.items),
];
const shotSizes = "(min-width: 1200px) 34rem, (min-width: 901px) 45vw, 94vw";
---

<BaseLayout title={t.meta.title} description={t.meta.description} locale={locale} path="/" jsonLd={jsonLd}>
  <HomeHero
    eyebrow={t.hero.eyebrow}
    title={t.hero.title}
    altTitle={H1_TEST_ENABLED ? HOME_H1_CATEGORY[locale] : undefined}
    lede={t.hero.lede}
    primary={{ label: t.hero.primary, href: startHref }}
    secondary={{ label: t.hero.secondary, href: `#${HOME_WORKFLOW_ANCHOR}` }}
    microcopy={t.hero.microcopy}
    note={t.hero.note}
    chat={{ ...t.hero.chat, label: ui.chatLabel, caption: ui.chatCaption }}
  />

  <MultiplayerWorkflow id={HOME_WORKFLOW_ANCHOR} {...story} kinds={ui.kinds} boardLabel={ui.boardLabel} />

  <section class="section">
    <div class="container home-stack">
      <SectionHead eyebrow={t.pillars.eyebrow} title={t.pillars.title} lede={t.pillars.lede} />
      <FeatureGrid items={t.pillars.items} columns={2} />
      <div class="home-foot" data-reveal>
        <a class="btn btn--ink" href={href("/features")}>{t.pillars.cta}<Icon name="arrow-right" class="arrow" /></a>
      </div>
    </div>
  </section>

  <section class="section band" id="use-cases">
    <div class="container home-stack">
      <SectionHead eyebrow={t.useCases.eyebrow} title={t.useCases.title} lede={t.useCases.lede} />
      <TocIndex items={homeUseCases.map((u) => ({ title: pick(u.title, locale), meta: pick(u.team, locale), href: href(`/use-cases/${u.slug}`), icon: u.icon }))} />
      <div class="home-foot" data-reveal>
        <a class="btn btn--ink" href={href("/use-cases")}>{t.useCases.cta}<Icon name="arrow-right" class="arrow" /></a>
      </div>
    </div>
  </section>

  <section class="section" id="console">
    <div class="container home-stack">
      <SectionHead eyebrow={t.product.eyebrow} title={t.product.title} lede={t.product.lede} />
      <div class="home-shots">
        <div class="home-shots__lead"><CcpShot {...ccpShotProps("teams", locale)} tape /></div>
        <CcpShot {...ccpShotProps("traces", locale)} sizes={shotSizes} />
        <CcpShot {...ccpShotProps("chat", locale)} sizes={shotSizes} />
      </div>
      <p class="home-small" data-reveal>{t.product.note}</p>
      <div class="home-foot" data-reveal>
        <a class="btn btn--ink" href={href("/architecture")}>{t.product.cta}<Icon name="arrow-right" class="arrow" /></a>
      </div>
    </div>
  </section>

  <section class="section band" id="integrations">
    <div class="container home-stack">
      <SectionHead eyebrow={t.integrations.eyebrow} title={t.integrations.title} lede={t.integrations.lede} />
      <LogoWall
        groups={[
          { label: t.integrations.channels, size: "l", items: CHANNELS.map((c) => ({ brand: c.brand, name: c.name, note: c.note ? pick(c.note, locale) : undefined })) },
          { label: t.integrations.providers, size: "s", items: PROVIDERS.map((p) => ({ brand: p.brand, name: p.name })) },
        ]}
      />
      <div class="home-deploy" data-reveal>
        <SectionHead title={t.integrations.deployTitle} lede={t.integrations.deployLede} level={3} size="m" />
        <ul class="home-chips" role="list" aria-label={ui.deployOptions}>
          {plans.map((p) => <li class="chip"><Icon name={p.icon as IconName} size={14} />{p.name}</li>)}
        </ul>
      </div>
      <div class="home-foot" data-reveal>
        <a class="btn btn--ink" href={href("/integrations")}>{t.integrations.cta}<Icon name="arrow-right" class="arrow" /></a>
      </div>
    </div>
  </section>

  <SecurityLayers
    eyebrow={t.security.eyebrow}
    title={t.security.title}
    lede={t.security.lede}
    layers={t.security.layers}
    core={ui.core}
    stamp={t.security.stamp}
    stampNote={t.security.stampNote}
    cta={{ label: t.security.cta, href: href("/security") }}
  />

  <HomeworkChecklist
    eyebrow={t.engineering.eyebrow}
    title={t.engineering.title}
    lede={t.engineering.lede}
    items={t.engineering.items}
    grade={t.engineering.grade}
    gradeLabel={ui.gradeLabel}
    signature={t.engineering.signature}
  />

  <section class="section band" id="deploy">
    <div class="container home-stack">
      <SectionHead eyebrow={t.pricing.eyebrow} title={t.pricing.title} lede={t.pricing.lede} />
      <DeployPlans plans={plans} includesLabel={ui.includes} tradeoffsLabel={ui.tradeoffs} badge={ui.badge} />
      <div class="home-foot" data-reveal>
        <a class="btn btn--ink" href={href("/pricing")}>{t.pricing.cta}<Icon name="arrow-right" class="arrow" /></a>
      </div>
    </div>
  </section>

  <section class="section section--tight">
    <div class="container home-faq">
      <SectionHead eyebrow={t.faq.eyebrow} title={t.faq.title} />
      <Faq items={t.faq.items} />
    </div>
  </section>

  <EarlyAccess {...earlyAccess} band />

  <section class="section section--tight" id="company">
    <div class="container home-company">
      <SectionHead eyebrow={t.company.eyebrow} title={t.company.title} lede={t.company.lede} size="m" />
      <div class="home-company__links" data-reveal>
        <a class="btn btn--ink" href={href("/story")}>{t.company.storyCta}<Icon name="arrow-right" class="arrow" /></a>
        <a class="btn" href={href("/about")}>{t.company.aboutCta}</a>
      </div>
    </div>
  </section>

  <CtaBand
    title={t.cta.title}
    body={t.cta.body}
    primary={{ label: t.cta.primary, href: startHref }}
    secondary={{ label: t.cta.secondary, href: href("/contact") }}
    note={t.cta.note}
  />
</BaseLayout>

<style>
  .home-stack { display: grid; gap: clamp(2.5rem, 1.5rem + 3vw, 4rem); }
  .home-foot { display: flex; justify-content: flex-start; }
  .home-small { font-size: var(--step--1); color: var(--ink-3); }
  .home-shots { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(2rem, 1rem + 3vw, 3.5rem) clamp(1.5rem, 1rem + 2vw, 2.5rem); }
  .home-shots__lead { grid-column: 1 / -1; }
  .home-deploy { display: grid; gap: var(--space-5); padding-block-start: var(--space-6); border-block-start: 1px solid var(--rule); }
  .home-chips { display: flex; flex-wrap: wrap; gap: var(--space-2); }
  .home-chips :global(svg) { color: var(--accent-ink); }
  .home-faq { display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 7fr); gap: clamp(2rem, 1rem + 4vw, 5rem); align-items: start; }
  .home-company { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 4fr); gap: var(--space-6) clamp(2rem, 1rem + 4vw, 5rem); align-items: end; }
  .home-company__links { display: flex; flex-wrap: wrap; gap: var(--space-3); }
  @media (max-width: 900px) {
    .home-faq, .home-company { grid-template-columns: minmax(0, 1fr); }
    .home-shots { grid-template-columns: minmax(0, 1fr); }
  }
  @media (max-width: 560px) {
    .home-company__links .btn { flex: 1 1 100%; }
  }
</style>
